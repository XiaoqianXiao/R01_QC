# Copy to config/mri_preproc.env and set the Flywheel project/date as needed.
# Every study input, output, log, and persistent work directory is below this root.
QC_ROOT="/gscratch/scrubbed/fanglab/xiaoqian/QC"
DICOM_DIR="${QC_ROOT}/sourcedata/dicom"
EXTRACTED_DICOM_DIR="${QC_ROOT}/sourcedata/dicom_extracted"
BIDS_DIR="${QC_ROOT}/bids"
WORK_DIR="${QC_ROOT}/work"
HEUDICONV_WORK_DIR="${WORK_DIR}/heudiconv"
MRIQC_WORK="${WORK_DIR}/mriqc"
LOG_DIR="${QC_ROOT}/logs"
FLYWHEEL_DOWNLOAD_LOG_DIR="${LOG_DIR}/flywheel"
MRIQC_LOG_DIR="${LOG_DIR}/mriqc"
MANIFEST_DIR="${QC_ROOT}/manifests"
SUMMARY_DIR="${QC_ROOT}/summaries"
MRIQC_OUT="${QC_ROOT}/mriqc"

# Flywheel intake. The start date is the default selection criterion.
FLYWHEEL_PROJECT_PATH="fang-lab/IFOCUS"
FLYWHEEL_START_DATE="2026-06-22"
FLYWHEEL_IMAGE="/gscratch/fang/resources/images/flywheel.sif"
FLYWHEEL_DOWNLOAD_PARTITION="ckpt-all"
FLYWHEEL_DOWNLOAD_TIME="04:00:00"
FLYWHEEL_DOWNLOAD_CPUS="4"
FLYWHEEL_DOWNLOAD_MEM="8G"
FLYWHEEL_DOWNLOAD_JOBS="4"

# Conversion and MRIQC.
CONTAINER_RUNTIME="apptainer"
APPTAINER_NO_MOUNT="bind-paths"
HEUDICONV_IMAGE="/gscratch/fang/resources/images/heudiconv.sif"
MRIQC_IMAGE="/gscratch/fang/resources/images/mriqc-24.0.2.sif"
MRIQC_MODALITIES="T1w T2w bold"
MRIQC_NO_SUB="1"
MRIQC_NPROC="16"
MRIQC_OMP_NTHREADS="8"
MRIQC_MEM_GB="64"
MRIQC_ARRAY_CONCURRENCY="0"
MRIQC_HYAK_TIME="24:00:00"
MRIQC_GROUP_HYAK_TIME="08:00:00"
EXTRA_MRIQC_ARGS=""

# Slurm and optional Python container for BIDS inventory reports.
HYAK_ACCOUNT="fang"
HYAK_PARTITION="ckpt-all"
PYTHON_CONTAINER_IMAGE="/gscratch/fang/resources/images/jupyter.sif"
PYTHON_CONTAINER_PYTHON="python3"
